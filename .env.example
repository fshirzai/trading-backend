NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trading_company?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-64-bytes
WEB_ORIGINS=http://localhost:3000
# 24 hours is provisional; agree the policy with the company before production.
RETURN_HOURS=24
RETURN_POLICY_CONFIRMED=false
UPLOAD_DIR=./var/uploads
# Set only when the app is behind exactly this many trusted proxy hops.
# TRUST_PROXY_HOPS=1
# Initial admin bootstrap only; remove these credentials after bootstrap.
ADMIN_NAME=Company Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# SMTP: TLS is mandatory (465 = implicit TLS; 587 = STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-user
SMTP_PASSWORD=replace-with-your-smtp-password
MAIL_FROM=company@example.com
EMAIL_BRAND_NAME=Trading Company
FRONTEND_URL=http://localhost:3000
# Separate encryption key; generate with randomBytes(32).toString('base64').
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Explicit false disables file upload, scanning and uploaded-file download.
# Generated PDFs remain available. Default true; requires ClamAV in production.
DOCUMENT_UPLOADS_ENABLED=true
# ClamAV daemon on a private network; required when uploads are enabled in production.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Default disabled. Enable only with a supported merchant account and sandbox validation.
GATEWAY_PROVIDER=disabled
GATEWAY_MERCHANT_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development/demo seed only. Never used in production.
SEED_PASSWORD=replace-with-a-strong-demo-password
